{
  "installCommand": "npm install",
  "buildCommand": "npx vite build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://backend-production-93717.up.railway.app/api/:path*"
    },
    {
      "source": "/embed/:path*",
      "destination": "https://backend-production-93717.up.railway.app/embed/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
