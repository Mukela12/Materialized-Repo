{
  "framework": "vite",
  "installCommand": "npm install",
  "buildCommand": "node script/vercel-build.mjs",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "mtrlzd.com" }],
      "missing": [{ "type": "host", "value": "www.mtrlzd.com" }],
      "destination": "https://www.mtrlzd.com/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://backend-production-93717.up.railway.app/api/:path*"
    },
    {
      "source": "/embed/:path*",
      "destination": "https://backend-production-93717.up.railway.app/embed/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
