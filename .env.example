# =============================================================================
# Video Commerce Engine — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values

# Database (Supabase PostgreSQL)
DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# Auth
SESSION_SECRET=generate-a-random-64-character-string-here
ACCESS_CODE=your-access-code-here

# Email (Resend)
RESEND_API_KEY=re_xxxxx
RESEND_FROM_EMAIL=hello@yourdomain.com

# Media (Cloudinary)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Payments (Stripe)
STRIPE_SECRET_KEY=sk_xxxxx
STRIPE_PUBLISHABLE_KEY=pk_xxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxx

# Platform currency — MUST match the Stripe account's settlement currency
# (a US Stripe account settles in USD, so transferring EUR fails). Default: usd.
PLATFORM_CURRENCY=usd

# Marketplace split defaults (percent of gross sale; admin-adjustable at runtime)
MARKETPLACE_FEE_PCT=15
CREATOR_COMMISSION_PCT=8
PUBLISHER_COMMISSION_PCT=2

# Signed store order webhooks (a per-store webhook_secret overrides these)
SHOPIFY_WEBHOOK_SECRET=
WC_WEBHOOK_SECRET=

# Admin (seeded on first startup)
ADMIN_EMAIL=admin@materialized.com
ADMIN_PASSWORD=secure-password-here

# App
PORT=5000
NODE_ENV=development
CORS_ORIGINS=http://localhost:5000,http://localhost:3000

# AI Detection (optional — Gemini)
# Set AI_INTEGRATIONS_GEMINI_API_KEY to activate REAL frame-based detection:
# sampled Cloudinary frames are sent to the Gemini vision model for product
# detection (real timestamps) and an AI-generated-content verdict. When unset —
# or when frames cannot be sampled — detection falls back to the metadata-only
# heuristic (title/description → product guess), with zero behavioural change.
AI_INTEGRATIONS_GEMINI_API_KEY=
AI_INTEGRATIONS_GEMINI_BASE_URL=

# Shopify Integration (optional — for inventory imports)
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=

# 32-byte key (64 hex chars) for encrypting store API tokens at rest.
# Generate: openssl rand -hex 32
ENCRYPTION_KEY=

# Error monitoring (Sentry — optional; unset = disabled)
# Leaving these blank fully disables Sentry: the SDK never initializes, so there
# is no instrumentation, no network calls, and no runtime cost. DSNs come from
# your Sentry project settings. VITE_* vars gate the browser SDK (inlined by Vite
# at build time); the unprefixed vars gate the backend SDK.
SENTRY_DSN=
SENTRY_ENVIRONMENT=
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=

# DocuSign eSignature (optional; unset = disabled -> falls back to the static
# signing link DOCUSIGN_SIGNING_URL, or https://app.docusign.com/templates).
# When all four required vars are set, the brand-agreement flow creates a real
# embedded-signing envelope via JWT Grant auth. Required: INTEGRATION_KEY (client
# id), USER_ID (impersonated user GUID), ACCOUNT_ID (API account GUID), PRIVATE_KEY
# (RSA private key PEM; \n-escaped is unescaped at runtime). Optional: BASE_URL
# (default https://demo.docusign.net for sandbox), TEMPLATE_ID (else an inline
# default agreement is used). The impersonated user must have granted consent.
DOCUSIGN_INTEGRATION_KEY=
DOCUSIGN_USER_ID=
DOCUSIGN_ACCOUNT_ID=
DOCUSIGN_PRIVATE_KEY=
DOCUSIGN_BASE_URL=
DOCUSIGN_TEMPLATE_ID=
DOCUSIGN_SIGNING_URL=
